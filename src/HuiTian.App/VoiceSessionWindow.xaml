<Window x:Class="HuiTian.App.VoiceSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="190" Height="238"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="VoiceControlButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#FFF2FAFF" />
            <Setter Property="Background" Value="#ED12243B" />
            <Setter Property="BorderBrush" Value="#9256D6F4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="22"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#F0304264" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Key="VoicePulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OrbHalo" Storyboard.TargetProperty="Opacity"
                             From="0.44" To="0.96" Duration="0:0:1.15" />
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleX"
                             From="0.91" To="1.09" Duration="0:0:1.15" />
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleY"
                             From="0.91" To="1.09" Duration="0:0:1.15" />
            <DoubleAnimation Storyboard.TargetName="OrbRotation" Storyboard.TargetProperty="Angle"
                             From="-16" To="24" Duration="0:0:2.8" />
            <DoubleAnimation Storyboard.TargetName="BarOneScale" Storyboard.TargetProperty="ScaleY"
                             From="0.32" To="0.9" Duration="0:0:0.42" BeginTime="0:0:0.00" />
            <DoubleAnimation Storyboard.TargetName="BarTwoScale" Storyboard.TargetProperty="ScaleY"
                             From="0.42" To="1" Duration="0:0:0.42" BeginTime="0:0:0.10" />
            <DoubleAnimation Storyboard.TargetName="BarThreeScale" Storyboard.TargetProperty="ScaleY"
                             From="0.30" To="0.94" Duration="0:0:0.42" BeginTime="0:0:0.20" />
            <DoubleAnimation Storyboard.TargetName="BarFourScale" Storyboard.TargetProperty="ScaleY"
                             From="0.36" To="1" Duration="0:0:0.42" BeginTime="0:0:0.30" />
        </Storyboard>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="142" />
            <RowDefinition Height="28" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Grid Width="132" Height="132" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse x:Name="OrbHalo" Margin="3" Opacity="0.78" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A556D6F4" Offset="0" />
                        <GradientStop Color="#929A7BFF" Offset="0.45" />
                        <GradientStop Color="#7467D8F2" Offset="0.72" />
                        <GradientStop Color="#3F56D6F4" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" /></Ellipse.RenderTransform>
                <Ellipse.Effect><BlurEffect Radius="12" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Margin="8">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform>
                            <RotateTransform x:Name="OrbRotation" CenterX="0.5" CenterY="0.5" />
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF193D62" Offset="0" />
                        <GradientStop Color="#FF285F91" Offset="0.28" />
                        <GradientStop Color="#FF684BC0" Offset="0.56" />
                        <GradientStop Color="#FF247C9E" Offset="0.78" />
                        <GradientStop Color="#FF102A4A" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#B0000A23" BlurRadius="25" ShadowDepth="6" Opacity="0.6" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Margin="8" Stroke="#C256D6F4" StrokeThickness="2" />
            <Ellipse Width="86" Height="35" Margin="17,17,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Fill="#6EC4F4FF" Opacity="0.62">
                <Ellipse.Effect><BlurEffect Radius="10" /></Ellipse.Effect>
            </Ellipse>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Rectangle Width="4" Height="20" RadiusX="2" RadiusY="2" Fill="#CFFFFFFF" Margin="2"
                           RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="BarOneScale" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle Width="4" Height="31" RadiusX="2" RadiusY="2" Fill="#F2FFFFFF" Margin="2"
                           RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="BarTwoScale" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle Width="4" Height="25" RadiusX="2" RadiusY="2" Fill="#F2FFFFFF" Margin="2"
                           RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="BarThreeScale" /></Rectangle.RenderTransform></Rectangle>
                <Rectangle Width="4" Height="17" RadiusX="2" RadiusY="2" Fill="#CFFFFFFF" Margin="2"
                           RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform x:Name="BarFourScale" /></Rectangle.RenderTransform></Rectangle>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="VoiceStateText" Grid.Row="1" Text="正在聆听"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="12" FontWeight="SemiBold" Foreground="White">
            <TextBlock.Effect><DropShadowEffect Color="#E0000000" BlurRadius="7" ShadowDepth="1" /></TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="TranscriptText" Visibility="Collapsed" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="MuteButton" Style="{StaticResource VoiceControlButton}"
                    ToolTip="关闭麦克风" AutomationProperties.Name="关闭麦克风"
                    Click="MuteButton_OnClick">
                <Path Width="17" Height="20" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M8.5,1 C6.6,1 5.2,2.5 5.2,4.4 V10.1 C5.2,12 6.6,13.5 8.5,13.5 C10.4,13.5 11.8,12 11.8,10.1 V4.4 C11.8,2.5 10.4,1 8.5,1 Z M2.8,9.2 C2.8,12.5 5.2,15 8.5,15 C11.8,15 14.2,12.5 14.2,9.2 L16,9.2 C16,13.1 13.2,16.3 9.4,16.8 L9.4,19 L12.8,19 L12.8,20.5 L4.2,20.5 L4.2,19 L7.6,19 L7.6,16.8 C3.8,16.3 1,13.1 1,9.2 Z" />
            </Button>
            <Button x:Name="HideVoiceButton" Style="{StaticResource VoiceControlButton}" Margin="11,0"
                    ToolTip="关闭语音框" AutomationProperties.Name="关闭语音框"
                    Click="HideButton_OnClick">
                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M1,1 L15,15 M15,1 L1,15" />
            </Button>
            <Button x:Name="StopSpeakingButton" Style="{StaticResource VoiceControlButton}"
                    ToolTip="停止朗读" AutomationProperties.Name="停止朗读"
                    Click="StopSpeakingButton_OnClick">
                <Path Width="20" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M2,7 L5.5,7 L10,3.2 L10,16.8 L5.5,13 L2,13 Z M12.2,7.2 C13.2,8.1 13.8,9.2 13.8,10 C13.8,10.8 13.2,11.9 12.2,12.8 L13.4,14 C14.8,12.8 15.6,11.3 15.6,10 C15.6,8.7 14.8,7.2 13.4,6 Z M15.3,4.2 C17.3,5.8 18.4,7.9 18.4,10 C18.4,12.1 17.3,14.2 15.3,15.8 L16.5,17 C18.9,15 20.2,12.5 20.2,10 C20.2,7.5 18.9,5 16.5,3 Z" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
