<Window x:Class="HuiTian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HuiTian.App"
        mc:Ignorable="d"
        Title="回天 AI" Icon="Assets/HuiTianLogo.ico"
        Width="1410" Height="870" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        PreviewKeyDown="MainWindow_OnPreviewKeyDown"
        AllowDrop="True"
        PreviewDragEnter="MainWindow_OnPreviewDragEnter"
        PreviewDragOver="MainWindow_OnPreviewDragOver"
        PreviewDragLeave="MainWindow_OnPreviewDragLeave"
        Drop="MainWindow_OnDrop">
    <Window.Resources>
        <Style x:Key="TierCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="TaskCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,11" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Field" Background="{DynamicResource PanelRaisedBrush}"
                                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                CornerRadius="9" Padding="10,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left" IsHitTestVisible="False"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}" />
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" StrokeThickness="1.7"
                                                      Stroke="{DynamicResource MutedBrush}" Margin="15,0,2,0"
                                                      VerticalAlignment="Center" IsHitTestVisible="False" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelRaisedBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        CornerRadius="9" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBackground" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,2">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource PanelBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="ItemBackground" Property="BorderThickness" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabHeader" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabHeader" Property="Background" Value="{DynamicResource PanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabHeader" Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1" Margin="0,0,0,12" />
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="14">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="MainExperience" Background="{DynamicResource PageBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ArtifactsColumn" Width="314" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="18,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource PanelRaisedBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                            <Image Source="Assets/HuiTianLogo.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="回天 AI" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="个人智能中枢" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Row="1" x:Name="NewTaskButton" Style="{StaticResource PrimaryButton}"
                            Margin="0,26,0,13" Padding="15,11" HorizontalContentAlignment="Left"
                            Content="＋  新任务" Click="NewTaskButton_OnClick" IsEnabled="False" />

                    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="11,8">
                        <DockPanel>
                            <TextBlock Text="⌕" FontSize="17" Margin="0,0,8,0"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBox x:Name="TaskSearchBox" FontSize="12" BorderThickness="0"
                                     ToolTip="搜索最近任务" Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}"
                                     TextChanged="TaskSearchBox_OnTextChanged" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,24,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="最近任务" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,11"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="RecentTasksPanel">
                                <TextBlock x:Name="NoRecentTasksText" Text="完成任务后会自动保存在本机"
                                           Margin="5,10,0,0" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Button Grid.Row="4" x:Name="SettingsButton" Style="{StaticResource GhostButton}"
                            Padding="13,11" HorizontalContentAlignment="Left"
                            Content="⚙  设置" Click="SettingsButton_OnClick" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="5" IsHitTestVisible="False" Panel.ZIndex="-1">
                    <Border.Background>
                        <RadialGradientBrush Center="1,0" GradientOrigin="1,0"
                                             RadiusX="0.78" RadiusY="0.7">
                            <GradientStop Color="#182B92AD" Offset="0" />
                            <GradientStop Color="#0B866FD0" Offset="0.34" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="30,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Width="42" Height="2" Background="{DynamicResource AccentBrush}"
                                Opacity="0.85" IsHitTestVisible="False" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="MainTaskTitle" Text="新的本机任务"
                                       FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       MaxWidth="590" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="智能工作台  /  对话与电脑操作" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock x:Name="TaskElapsedText" Text="" FontSize="11" Margin="10,0,0,0"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ArtifactPaneToggleButton" Style="{StaticResource GhostButton}"
                                    Content="隐藏产物栏" Padding="11,6" Margin="0,0,9,0"
                                    Click="ArtifactPaneToggleButton_OnClick" />
                            <Border Background="{DynamicResource SuccessPanelBrush}"
                                    BorderBrush="{DynamicResource SuccessTextBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7"
                                             Fill="{DynamicResource SuccessTextBrush}" Margin="0,0,7,0" />
                                    <TextBlock x:Name="ConnectionStatusText" Text="本机准备中"
                                               FontSize="11" Foreground="{DynamicResource SuccessTextBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ActivityScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="ActivityScroll_OnScrollChanged"
                              PreviewMouseWheel="ActivityScroll_OnPreviewMouseWheel">
                    <StackPanel x:Name="ActivityItems" Margin="32,28,32,18">
                        <Grid x:Name="WelcomePanel" Margin="2,15,2,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="3" Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="20" IsHitTestVisible="False" />
                            <Border Grid.ColumnSpan="3" HorizontalAlignment="Left" Width="4"
                                    Background="{DynamicResource AccentBrush}" CornerRadius="2,0,0,2"
                                    Opacity="0.8" IsHitTestVisible="False" />
                            <Border Width="48" Height="48" Margin="22,25,0,0" CornerRadius="14" ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Background="{DynamicResource PanelRaisedBrush}">
                                <Image Source="Assets/HuiTianLogo.png" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="17,24,22,25">
                                <TextBlock Text="HUITIAN  ·  PERSONAL AI" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="你好，我是回天。" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="直接告诉我结果目标。需要电脑操作时，我会自动观察并完成。"
                                           Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="可以试：找一个文件、打开程序、整理资料、操作网页或制作 PPT。"
                                           Margin="0,17,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                                                    <StackPanel x:Name="CharacterPanel" Grid.Column="2" Visibility="Collapsed" Margin="0,12,14,12">
                                <local:CharacterRevealView x:Name="CharacterPortrait" Width="220" Height="330" />
                                <Button Content="减少动态" Style="{StaticResource GhostButton}" Click="ReduceCharacterMotion_OnClick"
                                        HorizontalAlignment="Right" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="StartupStatusPanel" Grid.Row="1" Panel.ZIndex="5"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Width="430" Margin="24,22,24,0" Padding="19,16"
                        Background="{DynamicResource PanelRaisedBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                     Margin="0,5,10,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock x:Name="StartupStatusText" Text="正在唤醒回天"
                                           FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="文字与电脑任务服务准备中；语音按需启动" Margin="0,4,0,0"
                                           FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar x:Name="StartupProgressBar" Height="5" Margin="0,12,0,0"
                                     IsIndeterminate="True" Minimum="0" Maximum="100" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="RetryStartupButton" Content="重试启动" Visibility="Collapsed"
                                    Style="{StaticResource GhostButton}" Click="RetryStartupButton_OnClick" />
                            <Button x:Name="StartupLogsButton" Content="查看本机日志" Visibility="Collapsed" Margin="8,0,0,0"
                                    Style="{StaticResource GhostButton}" Click="StartupLogsButton_OnClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ApprovalPanel" Grid.Row="2" Visibility="Collapsed"
                        Margin="30,8,30,2" Padding="16" Background="{DynamicResource PanelRaisedBrush}"
                        BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1" CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ApprovalTitle" Text="请确认重要操作"
                                       FontWeight="SemiBold" Foreground="{DynamicResource GoldBrush}" />
                            <TextBlock x:Name="ApprovalDetail" Margin="0,5,12,7"
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <CheckBox x:Name="RememberApprovalCheckBox"
                                      Content="本次任务中记住同类选择" FontSize="11"
                                      Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="取消"
                                    Padding="14,8" Margin="0,0,8,0"
                                    x:Name="DeclineApprovalButton" Click="DeclineApprovalButton_OnClick" />
                            <Button x:Name="AcceptApprovalButton" Style="{StaticResource PrimaryButton}" Content="确认继续"
                                    Padding="14,8" Click="ApproveButton_OnClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="AttachmentTray" Grid.Row="3" Visibility="Collapsed"
                        Margin="30,8,30,0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="10,8">
                    <WrapPanel x:Name="AttachmentItems" />
                </Border>

                <Border x:Name="ComposerBorder" Grid.Row="4" Margin="30,10,30,22"
                        Background="{DynamicResource PanelRaisedBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="18" Padding="14,11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="MessageInput" MinHeight="55" MaxHeight="145"
                                 Padding="8,10" FontSize="14" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource AccentBrush}"
                                 PreviewKeyDown="MessageInput_OnKeyDown"
                                 TextChanged="MessageInput_OnTextChanged" />
                        <Grid Grid.Row="1" Margin="4,7,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="FileButton" Style="{StaticResource GhostButton}"
                                        Padding="10,6" FontSize="11" Content="＋ 文件"
                                        Click="FileButton_OnClick" IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="StopButton" Style="{StaticResource GhostButton}"
                                        Padding="14,8" Margin="0,0,8,0" Content="停止"
                                        Visibility="Collapsed" Click="StopButton_OnClick" />
                                <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}"
                                        Padding="18,8" Margin="0,0,8,0" Content="发送"
                                        Click="SendButton_OnClick" IsEnabled="False" />
                                <Button x:Name="VoiceButton" Width="42" Height="42" Padding="0"
                                        Background="{DynamicResource GoldBrush}" BorderThickness="0"
                                        Foreground="{DynamicResource AccentContrastBrush}"
                                        ToolTip="启动语音对话" AutomationProperties.Name="启动语音对话"
                                        Click="VoiceButton_OnClick" IsEnabled="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="VoiceButtonCircle" CornerRadius="22"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="VoiceButtonCircle" Property="Opacity" Value="0.84" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="VoiceButtonCircle" Property="Opacity" Value="0.78" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid Width="22" Height="22">
                                        <Rectangle Width="2.2" Height="8" RadiusX="1.1" RadiusY="1.1" Fill="{DynamicResource AccentContrastBrush}" HorizontalAlignment="Left" Margin="2,0,0,0" />
                                        <Rectangle Width="2.2" Height="14" RadiusX="1.1" RadiusY="1.1" Fill="{DynamicResource AccentContrastBrush}" HorizontalAlignment="Left" Margin="6.5,0,0,0" />
                                        <Rectangle Width="2.2" Height="19" RadiusX="1.1" RadiusY="1.1" Fill="{DynamicResource AccentContrastBrush}" HorizontalAlignment="Center" />
                                        <Rectangle Width="2.2" Height="13" RadiusX="1.1" RadiusY="1.1" Fill="{DynamicResource AccentContrastBrush}" HorizontalAlignment="Right" Margin="0,0,6.5,0" />
                                        <Rectangle Width="2.2" Height="7" RadiusX="1.1" RadiusY="1.1" Fill="{DynamicResource AccentContrastBrush}" HorizontalAlignment="Right" Margin="0,0,2,0" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="ArtifactsPane" Grid.Column="2" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Border Height="2" VerticalAlignment="Top" Margin="18,0,18,0"
                            Background="{DynamicResource GoldBrush}" Opacity="0.7"
                            IsHitTestVisible="False" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="19,25">
                        <Grid>
                            <TextBlock Text="任务产物" FontSize="15" FontWeight="SemiBold" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                    Content="×" Padding="8,3" ToolTip="隐藏产物栏"
                                    Click="ArtifactPaneToggleButton_OnClick" />
                        </Grid>
                        <TextBlock Text="生成或处理过的文件会出现在这里，可直接打开"
                                   FontSize="10" Margin="0,4,0,12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" />
                        <StackPanel x:Name="ArtifactItems">
                            <Border x:Name="NoArtifactsPanel" Style="{StaticResource TaskCard}" Padding="13,11">
                                <TextBlock Text="尚无任务产物" FontSize="11"
