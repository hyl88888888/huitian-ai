                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Ctrl + N" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="Ctrl + Shift + V" Margin="0,13,0,0" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="Esc" Margin="0,13,0,0" Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="本机能力">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="24">
                                    <TextBlock Text="本机诊断" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SettingsHardwareText" Text="正在读取本机配置"
                                               Margin="0,7,0,14" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                    <StackPanel x:Name="SettingsTierItems" Visibility="Collapsed" />
                                    <Button Style="{StaticResource GhostButton}" Content="手动检测硬件" HorizontalAlignment="Left"
                                            Margin="0,8,0,0" Click="RescanFromSettingsButton_OnClick" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="智能核心">
                            <StackPanel Margin="24">
                                <TextBlock Text="智能核心" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="使用本机已配置模型；需要时也可连接自己已有的本机智能服务。"
                                           Margin="0,6,0,14" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                <ComboBox x:Name="BrainModeCombo" Width="330" HorizontalAlignment="Left"
                                          Foreground="{DynamicResource TextBrush}"
                                          SelectionChanged="BrainModeCombo_OnSelectionChanged">
                                    <ComboBoxItem Tag="Automatic" Content="使用本机已配置模型" />
                                    <ComboBoxItem Tag="External" Content="使用我已有的本机智能服务" />
                                </ComboBox>
                                <StackPanel x:Name="ExternalBrainPanel" Visibility="Collapsed" Margin="0,18,0,0">
                                    <TextBlock Style="{StaticResource SettingsLabel}" Text="本机服务地址" />
                                    <TextBox x:Name="ExternalServiceAddressBox" Width="460" HorizontalAlignment="Left" Padding="10,8"
                                             Background="{DynamicResource PanelRaisedBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource LineBrush}" />
                                    <TextBlock Style="{StaticResource SettingsLabel}" Text="服务中的模型名称" Margin="0,14,0,6" />
                                    <TextBox x:Name="ExternalServiceNameBox" Width="330" HorizontalAlignment="Left" Padding="10,8"
                                             Background="{DynamicResource PanelRaisedBrush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource LineBrush}" />
                                    <TextBlock Text="保存后下次启动生效。该入口只连接客户自己已有的服务，不会购买或调用收费接口。"
                                               Margin="0,12,0,0" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"
                                Style="{StaticResource PrimaryButton}" Content="保存设置" Padding="18,9"
                                Click="SaveSettingsButton_OnClick" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
