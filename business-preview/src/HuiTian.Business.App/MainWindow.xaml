<Window x:Class="HuiTian.Business.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="回天 · 工作台" Width="1440" Height="960" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#F8FAFC" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#142C39" BorderBrush="#203C49" BorderThickness="0,0,1,0">
      <Grid Margin="18,27,18,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="8,0,0,30">
            <Border Width="33" Height="33" Background="#6DDED9" CornerRadius="9" Margin="0,0,11,0"><TextBlock Text="回" FontSize="20" FontWeight="Bold" Foreground="#173946" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel><TextBlock Text="回天" Foreground="#FAFFFF" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="HUITIAN WORKSPACE" FontFamily="Segoe UI" Foreground="#85A5B3" FontSize="8"/></StackPanel>
          </StackPanel>
          <Button x:Name="NewConversationButton" Click="NewConversation_Click" Background="#2C5665" BorderBrush="#426B76" Foreground="#F4FFFF" HorizontalContentAlignment="Center" Padding="14,12"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" Foreground="#A6F2EA" FontSize="18" Margin="0,0,10,0"/><TextBlock Text="新建对话" Foreground="#F4FFFF" VerticalAlignment="Center" FontSize="12"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,19,0,20">
          <Button x:Name="WorkspaceNavigation" Style="{StaticResource NavButton}" Click="Workspace_Click" Background="#234452"><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="#79E2DE" Width="26" FontSize="16"/><TextBlock Text="工作台" Foreground="#F0FFFF" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="LocalToolsNavigation" Style="{StaticResource NavButton}" Click="LocalTools_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▧" Foreground="#98B8C7" Width="26" FontSize="17"/><TextBlock Text="本地工具" Foreground="#C2D4DD" VerticalAlignment="Center"/><TextBlock Text="免模型" Foreground="#80BCAF" FontSize="8" VerticalAlignment="Center" Margin="11,0,0,0"/></StackPanel></Button>
          <Button x:Name="CapabilitiesNavigation" Style="{StaticResource NavButton}" Click="Capabilities_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⊞" Foreground="#98B8C7" Width="26" FontSize="17"/><TextBlock Text="能力与连接" Foreground="#C2D4DD" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="FilesNavigation" Style="{StaticResource NavButton}" Click="Files_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▱" Foreground="#98B8C7" Width="26" FontSize="17"/><TextBlock Text="交付文件" Foreground="#C2D4DD" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
        <Grid Grid.Row="2" Margin="11,0,7,11"><TextBlock Text="最近对话" FontSize="10" Foreground="#829DAB"/><TextBlock Text="本地保存" FontSize="9" Foreground="#668591" HorizontalAlignment="Right"/></Grid>
        <ListBox x:Name="ConversationList" Grid.Row="3" ItemsSource="{Binding Conversations}" SelectedItem="{Binding Selected, Mode=TwoWay}" SelectionChanged="ConversationList_SelectionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0" HorizontalContentAlignment="Stretch">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="12,11"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#294753"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#547581"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" Foreground="#D9E7EC" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusHint}" Foreground="#7899A9" FontSize="9" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4" Margin="0,18,0,0">
          <Border Background="#1B3845" CornerRadius="10" Padding="13" BorderBrush="#294B59" BorderThickness="1"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="#82D4C0" Margin="0,0,7,0"/><TextBlock Text="本地运行 · 未连接云端" Foreground="#C0DDD9" FontSize="10"/></StackPanel><TextBlock Text="对话与交付文件存储在本机" Foreground="#789BAA" FontSize="9" Margin="12,7,0,0"/></StackPanel></Border>
          <Button Style="{StaticResource NavButton}" Click="Settings_Click" Margin="0,9,0,0"><Grid Width="158"><TextBlock Text="⚙  设置与本机信息" Foreground="#ABC2CE" FontSize="10"/><TextBlock Text="0.1" Foreground="#6D8C9A" HorizontalAlignment="Right" FontSize="10"/></Grid></Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#FFFFFF" BorderBrush="#E4EBEF" BorderThickness="0,0,0,1">
        <Grid Margin="31,0,28,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="SectionTitle" Text="工作台" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="/" Foreground="#C4CDD2" Margin="17,1"/><TextBlock Text="{Binding Selected.Title}" FontSize="12" Foreground="#7B8B96" VerticalAlignment="Center" MaxWidth="400" TextTrimming="CharacterEllipsis"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Style="{StaticResource Pill}" Background="#F0F4F6"><TextBlock Text="商业版预览 0.1" Foreground="#607785" FontSize="10"/></Border><Button Click="OpenOutputs_Click" Padding="10,7" Margin="13,0,0,0" BorderThickness="0" Background="Transparent" Foreground="#738692" ToolTip="打开本机交付目录" Content="打开交付目录 ↗" FontSize="10"/></StackPanel>
        </Grid>
      </Border>

      <Border x:Name="RecoveryNotice" Grid.Row="1" Visibility="Collapsed" Background="#FFF4D6" Padding="20,10">
        <DockPanel><Button DockPanel.Dock="Right" Content="查看待核对记录" Click="RecoveryDetails_Click" Margin="16,0,0,0"/><TextBlock x:Name="RecoveryText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#694B12"/></DockPanel>
      </Border>
      <Grid Grid.Row="2" x:Name="WorkspaceArea">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.75,1"><GradientStop Color="#F1FAFB" Offset="0"/><GradientStop Color="#FAFCFD" Offset="0.48"/><GradientStop Color="#FAFCFD" Offset="1"/></LinearGradientBrush></Grid.Background>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ChatScroll_ScrollChanged">
            <Grid Margin="34,0,34,0">
              <StackPanel x:Name="WelcomePanel" Margin="10,65,10,30" Visibility="{Binding Selected.IsEmpty, Converter={StaticResource BoolVisibility}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22"><Border Background="#D5F0EF" Width="25" Height="25" CornerRadius="7" Margin="0,0,10,0"><TextBlock Text="✦" Foreground="#168C91" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="你的本地 AI 工作伙伴" FontSize="11" FontWeight="SemiBold" Foreground="#508C92" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Text="把想法交给回天，" FontSize="30" FontWeight="SemiBold" Foreground="#193746"/>
                <TextBlock Text="让工作落到实处。" FontSize="30" FontWeight="SemiBold" Foreground="#178E96" Margin="0,8,0,0"/>
                <TextBlock Text="描述目标，添加材料，查看每一步的真实进展。&#x0a;需要外部操作时，回天会先请求你的确认。" FontSize="12" LineHeight="23" Foreground="#788B97" Margin="0,20,0,33"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Click="Suggestion_Click" Tag="请帮我起草一份项目方案。请先询问项目背景、读者和目标，再生成 Word 文档。" Margin="0,0,8,0" Padding="15,18" HorizontalContentAlignment="Stretch" BorderBrush="#DCE8EC"><StackPanel><TextBlock Text="▤" Foreground="#2F929A" FontSize="22" Margin="0,0,0,16"/><TextBlock Text="写一份文档" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="方案、纪要与总结" FontSize="10" Foreground="#82949E" Margin="0,8,0,0"/><TextBlock Text="开始起草  ↗" FontSize="10" Foreground="#40999E" Margin="0,19,0,0"/></StackPanel></Button>
                  <Button Grid.Column="1" Click="Suggestion_Click" Tag="请帮我整理数据并生成 Excel 工作簿。请先确认数据来源、要分析的问题和需要的列。" Margin="4,0,4,0" Padding="15,18" HorizontalContentAlignment="Stretch" BorderBrush="#DCE8EC"><StackPanel><TextBlock Text="▦" Foreground="#578DA4" FontSize="22" Margin="0,0,0,16"/><TextBlock Text="整理一组数据" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="明细、对比与汇总" FontSize="10" Foreground="#82949E" Margin="0,8,0,0"/><TextBlock Text="开始整理  ↗" FontSize="10" Foreground="#40999E" Margin="0,19,0,0"/></StackPanel></Button>
                  <Button Grid.Column="2" Click="Suggestion_Click" Tag="请帮我制作一份演示文稿。请先确认主题、受众、页数与可用材料，然后生成 PowerPoint。" Margin="8,0,0,0" Padding="15,18" HorizontalContentAlignment="Stretch" BorderBrush="#DCE8EC"><StackPanel><TextBlock Text="▣" Foreground="#748AAE" FontSize="22" Margin="0,0,0,16"/><TextBlock Text="做一份演示" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="从提纲到演示文件" FontSize="10" Foreground="#82949E" Margin="0,8,0,0"/><TextBlock Text="开始构思  ↗" FontSize="10" Foreground="#40999E" Margin="0,19,0,0"/></StackPanel></Button>
                </Grid>
                <TextBlock Text="也可以直接提问，或让回天先帮你理清任务。" FontSize="10" Foreground="#96A7B0" Margin="0,23,0,0"/>
              </StackPanel>
              <ItemsControl x:Name="MessageList" ItemsSource="{Binding Selected.Messages}" Margin="0,24,0,20" Visibility="{Binding Selected.HasMessages, Converter={StaticResource BoolVisibility}}">
                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="28" Height="28" Background="{Binding RoleColor}" CornerRadius="8" VerticalAlignment="Top"><TextBlock Text="{Binding RoleMark}" FontSize="12" Foreground="#45626D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><Grid Margin="1,4,0,10"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding RoleLabel}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding TimeLabel}" FontSize="9" Foreground="#9AAAB2" Margin="10,1,0,0"/></StackPanel><Button Content="复制" FontSize="9" Padding="5,1" BorderThickness="0" Background="Transparent" Foreground="#8EA1AA" HorizontalAlignment="Right" Tag="{Binding Content}" Click="CopyMessage_Click"/></Grid><Border Background="White" CornerRadius="0,12,12,12" BorderBrush="#E3EDF0" BorderThickness="1" Padding="16,13"><TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" FontSize="12" Padding="0" IsReadOnlyCaretVisible="True" Cursor="IBeam"/></Border></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Margin="33,10,33,20">
            <Border Background="#EAF4F4" CornerRadius="8" Padding="11,9" Margin="0,0,0,10"><DockPanel><Button DockPanel.Dock="Right" Click="LocalTools_Click" Content="打开本地工具 ↗" Padding="5,1" FontSize="9" BorderThickness="0" Background="Transparent" Margin="8,0,0,0"/><TextBlock Text="自然语言执行仍在验证；明确的文件处理可用本地工具。" Foreground="#6A8A93" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
            <TextBlock x:Name="TransientNotice" Text="" TextWrapping="Wrap" Foreground="#9B6A39" FontSize="10" Margin="3,0,3,7" Visibility="Collapsed"/>
            <Border CornerRadius="15" Background="White" BorderBrush="#C8E0E3" BorderThickness="1" Padding="17,12,12,12">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ItemsControl x:Name="AttachmentList" ItemsSource="{Binding Selected.Attachments}" Margin="0,0,0,5"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,0,0,5"><Button DockPanel.Dock="Right" Content="×" FontSize="12" Padding="4,0" BorderThickness="0" Background="Transparent" Tag="{Binding}" Click="RemoveAttachment_Click"/><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" FontSize="10" Foreground="#438D96" VerticalAlignment="Center"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Grid Grid.Row="1"><TextBox x:Name="PromptInput" MinHeight="61" MaxHeight="145" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" Padding="0,5,3,5" FontSize="12" KeyDown="PromptInput_KeyDown" TextChanged="PromptInput_TextChanged"/><TextBlock x:Name="InputPlaceholder" Text="告诉回天，你想完成什么？" IsHitTestVisible="False" Foreground="#98AAB3" FontSize="12" Margin="0,5,0,0"/></Grid>
                <Grid Grid.Row="2" Margin="0,5,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="＋  添加材料" Click="AttachFiles_Click" Padding="8,6" FontSize="10" Background="#F3F7F8" BorderThickness="0" Foreground="#688490"/><TextBlock Text="本地模型" Margin="12,0,0,0" Foreground="#90A3AC" FontSize="9" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="StopButton" Content="■  停止" Click="Stop_Click" Padding="12,8" Foreground="#9A665C" Background="#FCF1EE" BorderThickness="0" Margin="0,0,7,0" Visibility="Collapsed"/><Button x:Name="SendButton" Click="Send_Click" Padding="17,8" Foreground="White" Background="#148F98" BorderBrush="#148F98"><TextBlock Text="发送  ↑" Foreground="White" FontSize="12"/></Button></StackPanel></Grid>
              </Grid>
            </Border>
            <Grid Margin="5,10,3,0"><TextBlock Text="Enter 发送 · Shift + Enter 换行" FontSize="9" Foreground="#9DAEB5"/><TextBlock Text="重要内容请核验" FontSize="9" Foreground="#9DAEB5" HorizontalAlignment="Right"/></Grid>
          </StackPanel>
        </Grid>

        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E4ECF0" BorderThickness="1,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="23,28,23,22">
            <Grid><TextBlock Text="本机状态" FontSize="12" FontWeight="SemiBold"/><Button Content="刷新" Click="RefreshStatus_Click" Padding="0" FontSize="9" Foreground="#8EA3AC" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"/></Grid>
            <Border Background="#F2F8F9" CornerRadius="10" BorderBrush="#E4EFF1" BorderThickness="1" Padding="15" Margin="0,16,0,0"><StackPanel><TextBlock Text="{Binding RuntimeTitle}" Foreground="#327782" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding RuntimeDetail}" Foreground="#7C929C" FontSize="10" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"/></StackPanel></Border>
            <StackPanel Margin="1,18,0,0"><TextBlock Text="推理模型" Foreground="#A0AFB7" FontSize="9"/><TextBlock Text="{Binding ModelText}" Foreground="#5F7885" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,14"/><TextBlock Text="本机资源" Foreground="#A0AFB7" FontSize="9"/><TextBlock Text="{Binding HardwareText}" Foreground="#5F7885" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
            <Border Height="1" Background="#EAF0F3" Margin="0,25,0,24"/>
            <Grid><TextBlock Text="执行记录" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Selected.RunStatus}" Foreground="#8FA2AC" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <StackPanel Visibility="{Binding Selected.IsEmpty, Converter={StaticResource BoolVisibility}}" Margin="0,23,0,0"><Border Width="34" Height="34" HorizontalAlignment="Left" Background="#F2F6F8" CornerRadius="10"><TextBlock Text="⌁" Foreground="#8EA8B5" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="从一个目标开始" FontSize="11" Foreground="#728995" Margin="0,13,0,0"/><TextBlock Text="回天会在这里记录计划、工具调用、&#x0a;需要确认的操作与结果。" FontSize="10" Foreground="#9BADB5" LineHeight="19" Margin="0,8,0,0"/></StackPanel>
            <ItemsControl ItemsSource="{Binding Selected.Timeline}" Margin="0,18,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="5" Height="5" Fill="#69B3B7" VerticalAlignment="Top" Margin="0,5,0,0"/><StackPanel Grid.Column="1"><Grid><TextBlock Text="{Binding Label}" FontSize="10" Foreground="#597581"/><TextBlock Text="{Binding Time}" FontFamily="Segoe UI" FontSize="8" Foreground="#A5B4BD" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#8DA0AA" FontSize="9" LineHeight="17" Margin="0,6,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <StackPanel Visibility="{Binding Selected.HasArtifacts, Converter={StaticResource BoolVisibility}}"><Border Height="1" Background="#EAF0F3" Margin="0,14,0,23"/><TextBlock Text="本次对话的交付" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,15"/><ItemsControl ItemsSource="{Binding Selected.Artifacts}"><ItemsControl.ItemTemplate><DataTemplate><Button Click="Artifact_Click" Tag="{Binding}" Margin="0,0,0,8" Padding="10" HorizontalContentAlignment="Stretch" Background="#F9FBFC"><StackPanel><TextBlock Text="{Binding Name}" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="打开文件  ↗" Foreground="#64A3AC" FontSize="9" Margin="0,6,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            <Border Background="#FAFCFD" BorderBrush="#EDF2F4" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,27,0,0"><TextBlock Text="执行记录来自实际运行。&#x0a;文件生成后会显示在交付列表中。" FontSize="9" Foreground="#9BAEB8" LineHeight="18"/></Border>
          </StackPanel></ScrollViewer>
        </Border>
      </Grid>

      <ScrollViewer x:Name="CapabilitiesArea" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="44,39,44,35"><TextBlock Text="能力与连接" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="当前工具来自本机注册表。运行时会记录结果；外部操作需要确认。" Foreground="#7E919D" FontSize="12" Margin="0,13,0,24" TextWrapping="Wrap"/><ItemsControl x:Name="CapabilitiesList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#E2EBEF" BorderThickness="1" CornerRadius="12" Padding="21,18" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="#8296A2" Margin="0,10,0,10" TextWrapping="Wrap"/><TextBlock Text="{Binding Risk, StringFormat=操作类别：{0}}" FontSize="10" Foreground="#4B9198"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
      <ScrollViewer x:Name="FilesArea" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="44,39,44,35"><TextBlock Text="交付文件" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="来自本地对话记录的实际交付，可返回原对话继续处理。" Foreground="#7E919D" FontSize="12" Margin="0,13,0,24"/><TextBlock x:Name="NoFilesLabel" Text="还没有交付文件。完成任务后，文件会显示在这里。" Foreground="#95A7B1" FontSize="12" Margin="0,24"/><ItemsControl x:Name="AllFilesList"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="Artifact_Click" HorizontalContentAlignment="Stretch" Padding="20" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" FontSize="10" Foreground="#819AA5" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</Window>
