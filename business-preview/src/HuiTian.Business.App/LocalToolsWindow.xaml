<Window x:Class="HuiTian.Business.App.LocalToolsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="本地工具 · 回天" Width="860" Height="800" MinWidth="690" MinHeight="640" WindowStartupLocation="CenterOwner" Background="#F6FAFB" FontFamily="Microsoft YaHei UI, Segoe UI">
  <Grid Margin="30,25,30,23">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,22"><Grid><TextBlock Text="本地工具" FontSize="25" FontWeight="SemiBold"/><Border Background="#DEF1ED" CornerRadius="6" Padding="10,6" HorizontalAlignment="Right"><TextBlock Text="无需启动模型" Foreground="#35837C" FontSize="10"/></Border></Grid><TextBlock Text="选择文件，填写参数，直接完成办公文件处理。输出保存为新文件。" Foreground="#7D94A0" FontSize="11" Margin="0,11,0,0" TextWrapping="Wrap"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
      <StackPanel x:Name="OperationForm">
        <TextBlock Text="选择操作" FontSize="11" Foreground="#6C8592" Margin="0,0,0,9"/>
        <ComboBox x:Name="OperationPicker" Height="36" FontSize="12" SelectionChanged="Operation_Changed" Padding="9,4"><ComboBoxItem Content="PPTX · 修改背景与字体"/><ComboBoxItem Content="XLSX · 按列去重"/><ComboBoxItem Content="文档 · 提取文字到 TXT"/></ComboBox>
        <Border Background="#EAF4F5" CornerRadius="9" Padding="13" Margin="0,13,0,20"><TextBlock x:Name="OperationDescription" Foreground="#63838E" TextWrapping="Wrap" FontSize="11" LineHeight="19"/></Border>
        <TextBlock Text="源文件" FontSize="11" Foreground="#6C8592" Margin="0,0,0,8"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="选择文件…" Click="SelectSource_Click" Margin="10,0,0,0" Padding="14,8"/><TextBox x:Name="SourcePath" IsReadOnly="True" Padding="10,8" BorderBrush="#DBE7EC" BorderThickness="1" FontSize="11" TextWrapping="Wrap" VerticalContentAlignment="Center"/></DockPanel>
        <StackPanel x:Name="PresentationFields" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="背景颜色" FontSize="11" Foreground="#6C8592" Margin="0,0,0,8"/><TextBox x:Name="BackgroundInput" Text="FFFFFF" Padding="10,8" BorderBrush="#DBE7EC" BorderThickness="1"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="文字颜色" FontSize="11" Foreground="#6C8592" Margin="0,0,0,8"/><TextBox x:Name="FontColorInput" Text="172D3D" Padding="10,8" BorderBrush="#DBE7EC" BorderThickness="1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="字体名称" FontSize="11" Foreground="#6C8592" Margin="0,0,0,8"/><TextBox x:Name="FontFamilyInput" Text="Microsoft YaHei" Padding="10,8" BorderBrush="#DBE7EC" BorderThickness="1"/></StackPanel></Grid><TextBlock Text="色值示例：FFFFFF（白色）、172D3D（深蓝）；字体应已安装在本机。" Foreground="#91A5AE" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
        <Grid x:Name="WorksheetFields" Margin="0,20,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="工作表名称" FontSize="11" Foreground="#6C8592" Margin="0,0,0,8"/><TextBox x:Name="SheetInput" Text="Sheet1" Padding="10,8" BorderBrush="#DBE7EC" BorderThickness="1"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="用于判断重复的列" FontSize="11" Foreground="#6C8592" Margin="0,0,0,8"/><TextBox x:Name="ColumnsInput" Text="A" Padding="10,8" BorderBrush="#DBE7EC" BorderThickness="1"/><TextBlock Text="多列用逗号分隔，例如 A,C" Foreground="#91A5AE" FontSize="10" Margin="0,9,0,0"/></StackPanel></Grid>
        <StackPanel x:Name="ExtractionFields" Margin="0,20,0,0" Visibility="Collapsed"><TextBlock Text="最多提取的字符数（1–64,000）" FontSize="11" Foreground="#6C8592" Margin="0,0,0,8"/><TextBox x:Name="LimitInput" Text="64000" Padding="10,8" BorderBrush="#DBE7EC" BorderThickness="1" Width="180" HorizontalAlignment="Left"/><TextBlock Text="超过上限时会在结果及 TXT 中注明“部分提取”。不识别图片中的文字。" Foreground="#91A5AE" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
        <TextBlock Text="输出文件名" FontSize="11" Foreground="#6C8592" Margin="0,22,0,8"/><TextBox x:Name="OutputName" Padding="10,8" BorderBrush="#DBE7EC" BorderThickness="1" FontSize="11"/><TextBlock x:Name="OutputDirectory" Foreground="#91A5AE" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Background="White" BorderBrush="#E0EAEE" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,22,0,0"><StackPanel><TextBlock x:Name="ResultHeading" Text="准备就绪" FontSize="12" FontWeight="SemiBold"/><TextBox x:Name="ResultDescription" Text="选择文件后即可执行。原文件保留；已有输出文件不会被覆盖。" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" Foreground="#8398A3" Margin="0,9,0,0"/><ItemsControl x:Name="ResultArtifacts" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Button Click="OpenArtifact_Click" Tag="{Binding}" Padding="10" Margin="0,5,0,0" HorizontalContentAlignment="Left" Background="#F0F8F8" BorderThickness="0"><TextBlock Text="{Binding Name, StringFormat=打开文件  ↗  {0}}" FontSize="11" Foreground="#328C94"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="2" Margin="0,20,0,0"><TextBlock Text="本机处理 · 新副本 · 不调用模型" Foreground="#91A5AE" FontSize="10" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelOperation" Content="取消操作" Click="Cancel_Click" Padding="17,10" Margin="0,0,10,0" Visibility="Collapsed"/><Button x:Name="ExecuteOperation" Click="Execute_Click" Padding="22,10" Background="#148F98" BorderThickness="0"><TextBlock Text="执行本地操作" Foreground="White" FontSize="12"/></Button></StackPanel></Grid>
  </Grid>
</Window>
