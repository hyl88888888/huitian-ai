<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Reference Include="sherpa-onnx">
      <HintPath>..\..\vendor\sherpa-onnx\sherpa-onnx.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="..\..\vendor\sherpa-onnx\onnxruntime.dll"
          Link="onnxruntime.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\vendor\sherpa-onnx\sherpa-onnx-c-api.dll"
          Link="sherpa-onnx-c-api.dll" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\..\src\HuiTian.App\NaturalVoiceSynthesizer.cs"
             Link="NaturalVoiceSynthesizer.cs" />
    <Compile Include="..\..\src\HuiTian.App\VoiceUtterancePolicy.cs"
             Link="VoiceUtterancePolicy.cs" />
  </ItemGroup>
</Project>
